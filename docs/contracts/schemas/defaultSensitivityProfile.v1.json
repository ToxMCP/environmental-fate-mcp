{
  "$defs": {
    "DefaultSensitivityTargetType": {
      "enum": [
        "parameter",
        "scenario_duration_days",
        "scenario_temperature_c",
        "release_fraction"
      ],
      "title": "DefaultSensitivityTargetType",
      "type": "string"
    },
    "Media": {
      "enum": [
        "air",
        "water",
        "soil",
        "sediment"
      ],
      "title": "Media",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "target_type": {
      "$ref": "#/$defs/DefaultSensitivityTargetType"
    },
    "parameter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter"
    },
    "medium": {
      "anyOf": [
        {
          "$ref": "#/$defs/Media"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "factor_values": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Factor Values",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source References",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "source_pack": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Pack"
    },
    "applicability_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability Note"
    }
  },
  "required": [
    "profile_id",
    "display_name",
    "target_type",
    "factor_values"
  ],
  "title": "DefaultSensitivityProfile",
  "type": "object"
}
