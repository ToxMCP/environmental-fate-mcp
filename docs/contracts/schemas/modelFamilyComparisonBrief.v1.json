{
  "$defs": {
    "FitForPurpose": {
      "enum": [
        "screening",
        "downstream_export",
        "benchmark"
      ],
      "title": "FitForPurpose",
      "type": "string"
    },
    "LimitationNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "LimitationNote",
      "type": "object"
    },
    "ModelFamily": {
      "enum": [
        "reference_mass_balance",
        "advective_screening_mass_balance",
        "adapter_stub",
        "external_result_adapter"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "ModelFamilyComparisonOutcome": {
      "enum": [
        "comparable_screening_outputs",
        "material_model_family_divergence",
        "review_needed"
      ],
      "title": "ModelFamilyComparisonOutcome",
      "type": "string"
    },
    "RunMode": {
      "enum": [
        "steady_state",
        "time_bucket"
      ],
      "title": "RunMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "comparison_packet_id": {
      "title": "Comparison Packet Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "run_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "fit_for_purpose": {
      "$ref": "#/$defs/FitForPurpose"
    },
    "comparison_profile_id": {
      "title": "Comparison Profile Id",
      "type": "string"
    },
    "base_model_family": {
      "$ref": "#/$defs/ModelFamily"
    },
    "candidate_model_family": {
      "$ref": "#/$defs/ModelFamily"
    },
    "comparison_outcome": {
      "$ref": "#/$defs/ModelFamilyComparisonOutcome"
    },
    "summary_lines": {
      "items": {
        "type": "string"
      },
      "title": "Summary Lines",
      "type": "array"
    },
    "dominant_delta_lines": {
      "items": {
        "type": "string"
      },
      "title": "Dominant Delta Lines",
      "type": "array"
    },
    "outcome_lines": {
      "items": {
        "type": "string"
      },
      "title": "Outcome Lines",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "base_equation_lines": {
      "items": {
        "type": "string"
      },
      "title": "Base Equation Lines",
      "type": "array"
    },
    "candidate_equation_lines": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Equation Lines",
      "type": "array"
    },
    "brief_template_used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brief Template Used"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/LimitationNote"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "comparison_packet_id",
    "scenario_id",
    "run_mode",
    "fit_for_purpose",
    "comparison_profile_id",
    "base_model_family",
    "candidate_model_family",
    "comparison_outcome",
    "summary_lines"
  ],
  "title": "ModelFamilyComparisonBrief",
  "type": "object"
}
