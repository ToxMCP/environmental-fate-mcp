    "review_status": {
      "title": "Review Status",
      "type": "string"
    },
    "triggered_check_codes": {
      "items": {
        "type": "string"
      },
      "title": "Triggered Check Codes",
      "type": "array"
    },
    "governing_rule_lines": {
      "items": {
        "type": "string"
      },
      "title": "Governing Rule Lines",
      "type": "array"
    },
    "status_rule_lines": {
      "items": {
        "type": "string"
      },
      "title": "Status Rule Lines",
      "type": "array"
    },
    "triggered_signal_lines": {
      "items": {
        "type": "string"
      },
      "title": "Triggered Signal Lines",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "selection_profile_id",
    "recommendation_status",
    "primary_model_family",
    "review_status"
