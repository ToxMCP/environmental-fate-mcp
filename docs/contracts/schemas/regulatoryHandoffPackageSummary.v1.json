          "type": "number"
        },
        "concentration_unit": {
          "title": "Concentration Unit",
          "type": "string"
        },
        "downstream_field": {
          "title": "Downstream Field",
          "type": "string"
        },
        "route_hint": {
          "title": "Route Hint",
          "type": "string"
