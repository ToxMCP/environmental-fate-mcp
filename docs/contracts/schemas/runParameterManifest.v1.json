{
  "$defs": {
    "DefaultEvidenceStatus": {
      "enum": [
        "source_backed_defaults",
        "governed_overrides_present",
        "legacy_continuity_assumptions_present"
      ],
      "title": "DefaultEvidenceStatus",
      "type": "string"
    },
    "EscalationConcern": {
      "enum": [
        "extreme_persistence",
        "strong_spatial_heterogeneity",
        "point_source_plume_dependence",
        "pfas_like_transport",
        "jurisdictional_probabilistic_requirement"
      ],
      "title": "EscalationConcern",
      "type": "string"
    },
    "FitForPurpose": {
      "enum": [
        "screening",
        "downstream_export",
        "benchmark"
      ],
      "title": "FitForPurpose",
      "type": "string"
    },
    "LimitationNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "LimitationNote",
      "type": "object"
    },
    "ModelFamily": {
      "enum": [
        "reference_mass_balance",
        "advective_screening_mass_balance",
        "adapter_stub",
        "external_result_adapter"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "ProvenanceBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "defaults_version": {
          "default": "v1",
          "title": "Defaults Version",
          "type": "string"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "algorithm_version",
        "generated_at"
      ],
      "title": "ProvenanceBundle",
      "type": "object"
    },
    "RunDefaultProofPosture": {
      "enum": [
        "rebaselined_shipped_defaults",
        "rebaselined_defaults_with_governed_overrides",
        "scenario_specific_non_default_values",
        "legacy_continuity_extension"
      ],
      "title": "RunDefaultProofPosture",
      "type": "string"
    },
    "RunParameterManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "title": "Parameter",
          "type": "string"
        },
        "resolved_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Resolved Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "source_classification": {
          "$ref": "#/$defs/SourceClassification"
        },
        "evidence_quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Quality"
        },
        "runtime_consumed": {
          "title": "Runtime Consumed",
          "type": "boolean"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Reference Ids",
          "type": "array"
        },
        "quality_flag_codes": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flag Codes",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "parameter",
        "resolved_value",
        "source_classification",
        "runtime_consumed",
        "rationale"
      ],
      "title": "RunParameterManifestEntry",
      "type": "object"
    },
    "SourceClassification": {
      "enum": [
        "user_input",
        "curated_default",
        "derived",
        "heuristic"
      ],
      "title": "SourceClassification",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "model_family": {
      "$ref": "#/$defs/ModelFamily"
    },
    "fit_for_purpose": {
      "$ref": "#/$defs/FitForPurpose"
    },
    "escalation_concerns": {
      "items": {
        "$ref": "#/$defs/EscalationConcern"
      },
      "title": "Escalation Concerns",
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/RunParameterManifestEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "default_evidence_status": {
      "$ref": "#/$defs/DefaultEvidenceStatus",
      "default": "source_backed_defaults"
    },
    "default_proof_posture": {
      "$ref": "#/$defs/RunDefaultProofPosture",
      "default": "rebaselined_shipped_defaults"
    },
    "default_evidence_lines": {
      "items": {
        "type": "string"
      },
      "title": "Default Evidence Lines",
      "type": "array"
    },
    "proof_posture_lines": {
      "items": {
        "type": "string"
      },
      "title": "Proof Posture Lines",
      "type": "array"
    },
    "scientific_change_lines": {
      "items": {
        "type": "string"
      },
      "title": "Scientific Change Lines",
      "type": "array"
    },
    "default_sensitivity_lines": {
      "items": {
        "type": "string"
      },
      "title": "Default Sensitivity Lines",
      "type": "array"
    },
    "rebaselined_default_parameters": {
      "items": {
        "type": "string"
      },
      "title": "Rebaselined Default Parameters",
      "type": "array"
    },
    "governed_override_parameters": {
      "items": {
        "type": "string"
      },
      "title": "Governed Override Parameters",
      "type": "array"
    },
    "material_default_sensitivity": {
      "default": false,
      "title": "Material Default Sensitivity",
      "type": "boolean"
    },
    "core_default_assumption_count": {
      "default": 0,
      "minimum": 0,
      "title": "Core Default Assumption Count",
      "type": "integer"
    },
    "summary_lines": {
      "items": {
        "type": "string"
      },
      "title": "Summary Lines",
      "type": "array"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/LimitationNote"
      },
      "title": "Limitations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceBundle"
    }
  },
  "required": [
    "scenario_id",
    "run_id",
    "model_family",
    "fit_for_purpose",
    "entries",
    "summary_lines",
    "provenance"
  ],
  "title": "RunParameterManifest",
  "type": "object"
}
