{
  "$defs": {
    "FitForPurpose": {
      "enum": [
        "screening",
        "downstream_export",
        "benchmark"
      ],
      "title": "FitForPurpose",
      "type": "string"
    },
    "RunMode": {
      "enum": [
        "steady_state",
        "time_bucket"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "ScientificClaimSupportStrength": {
      "enum": [
        "uncovered",
        "single_anchor",
        "multi_anchor_single_tier",
        "multi_anchor_multi_tier"
      ],
      "title": "ScientificClaimSupportStrength",
      "type": "string"
    },
    "ScientificExternalCorroborationStatus": {
      "enum": [
        "none",
        "single_official_source",
        "multi_official_single_jurisdiction",
        "multi_official_multi_jurisdiction"
      ],
      "title": "ScientificExternalCorroborationStatus",
      "type": "string"
    },
    "ScientificValidationClaimPriority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ScientificValidationClaimPriority",
      "type": "string"
    },
    "ScientificWorksheetStatus": {
      "enum": [
        "ready",
        "review_needed",
        "missing"
      ],
      "title": "ScientificWorksheetStatus",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "claim_class": {
      "title": "Claim Class",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/ScientificValidationClaimPriority"
    },
    "mandatory_for_release": {
      "title": "Mandatory For Release",
      "type": "boolean"
    },
    "supported_run_modes": {
      "items": {
        "$ref": "#/$defs/RunMode"
      },
      "title": "Supported Run Modes",
      "type": "array"
    },
    "fit_for_purpose": {
      "items": {
        "$ref": "#/$defs/FitForPurpose"
      },
      "title": "Fit For Purpose",
      "type": "array"
    },
    "required_validation_tiers": {
      "items": {
        "type": "string"
      },
      "title": "Required Validation Tiers",
      "type": "array"
    },
    "required_reference_types": {
      "items": {
        "type": "string"
      },
      "title": "Required Reference Types",
      "type": "array"
    },
    "covered": {
      "title": "Covered",
      "type": "boolean"
    },
    "support_strength": {
      "$ref": "#/$defs/ScientificClaimSupportStrength",
      "default": "uncovered"
    },
    "supporting_fixture_count": {
      "default": 0,
      "title": "Supporting Fixture Count",
      "type": "integer"
    },
    "reference_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reference Case Ids",
      "type": "array"
    },
    "supporting_fixture_names": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Fixture Names",
      "type": "array"
    },
    "supporting_reference_types": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Reference Types",
      "type": "array"
    },
    "supporting_validation_tiers": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Validation Tiers",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source References",
      "type": "array"
    },
    "external_corroboration_status": {
      "$ref": "#/$defs/ScientificExternalCorroborationStatus",
      "default": "none"
    },
    "external_corroboration_source_count": {
      "default": 0,
      "title": "External Corroboration Source Count",
      "type": "integer"
    },
    "external_corroboration_jurisdictions": {
      "items": {
        "type": "string"
      },
      "title": "External Corroboration Jurisdictions",
      "type": "array"
    },
    "evidence_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Family"
    },
    "official_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Official Source Ids",
      "type": "array"
    },
    "worksheet_artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worksheet Artifact Path"
    },
    "expected_output_artifact_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Output Artifact Path"
    },
    "worksheet_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScientificWorksheetStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_reviewed_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Reviewed Date"
    },
    "tolerance_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tolerance Basis"
    },
    "reviewer_grade_passed": {
      "default": false,
      "title": "Reviewer Grade Passed",
      "type": "boolean"
    },
    "external_corroboration_lines": {
      "items": {
        "type": "string"
      },
      "title": "External Corroboration Lines",
      "type": "array"
    },
    "source_grounding_lines": {
      "items": {
        "type": "string"
      },
      "title": "Source Grounding Lines",
      "type": "array"
    },
    "methods_basis_lines": {
      "items": {
        "type": "string"
      },
      "title": "Methods Basis Lines",
      "type": "array"
    },
    "reference_case_lines": {
      "items": {
        "type": "string"
      },
      "title": "Reference Case Lines",
      "type": "array"
    },
    "reference_case_concept_lines": {
      "items": {
        "type": "string"
      },
      "title": "Reference Case Concept Lines",
      "type": "array"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Review Notes",
      "type": "array"
    },
    "gap_lines": {
      "items": {
        "type": "string"
      },
      "title": "Gap Lines",
      "type": "array"
    }
  },
  "required": [
    "claim_id",
    "display_name",
    "statement",
    "claim_class",
    "priority",
    "mandatory_for_release",
    "covered"
  ],
  "title": "ScientificMethodsDossierClaimSummary",
  "type": "object"
}
