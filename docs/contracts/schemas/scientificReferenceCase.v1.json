{
  "$defs": {
    "ModelFamily": {
      "enum": [
        "reference_mass_balance",
        "advective_screening_mass_balance",
        "adapter_stub",
        "external_result_adapter"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "model_families": {
      "items": {
        "$ref": "#/$defs/ModelFamily"
      },
      "title": "Model Families",
      "type": "array"
    },
    "jurisdictions": {
      "items": {
        "type": "string"
      },
      "title": "Jurisdictions",
      "type": "array"
    },
    "source_type": {
      "title": "Source Type",
      "type": "string"
    },
    "evidence_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Family"
    },
    "official_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Official Source Ids",
      "type": "array"
    },
    "last_reviewed_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Reviewed Date"
    },
    "summary_lines": {
      "items": {
        "type": "string"
      },
      "title": "Summary Lines",
      "type": "array"
    },
    "applicability_lines": {
      "items": {
        "type": "string"
      },
      "title": "Applicability Lines",
      "type": "array"
    },
    "scientific_unsuitability_lines": {
      "items": {
        "type": "string"
      },
      "title": "Scientific Unsuitability Lines",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source References",
      "type": "array"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Review Notes",
      "type": "array"
    },
    "source_pack": {
      "title": "Source Pack",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "display_name",
    "source_type",
    "source_pack"
  ],
  "title": "ScientificReferenceCase",
  "type": "object"
}
