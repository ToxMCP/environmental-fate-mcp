{
  "$defs": {
    "Compartment": {
      "enum": [
        "ambient_air",
        "surface_water",
        "agricultural_soil",
        "freshwater_sediment"
      ],
      "title": "Compartment",
      "type": "string"
    },
    "DefaultEvidenceStatus": {
      "enum": [
        "source_backed_defaults",
        "governed_overrides_present",
        "legacy_continuity_assumptions_present"
      ],
      "title": "DefaultEvidenceStatus",
      "type": "string"
    },
    "EscalationConcern": {
      "enum": [
        "extreme_persistence",
        "strong_spatial_heterogeneity",
        "point_source_plume_dependence",
        "pfas_like_transport",
        "jurisdictional_probabilistic_requirement"
      ],
      "title": "EscalationConcern",
      "type": "string"
    },
    "FitAssessmentPenaltyWeights": {
      "additionalProperties": false,
      "properties": {
        "unsupported_fit_for_purpose": {
          "default": 0.25,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unsupported Fit For Purpose",
          "type": "number"
        },
        "excessive_time_bucket_count": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Excessive Time Bucket Count",
          "type": "number"
        },
        "provenance_only_treatments": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Provenance Only Treatments",
          "type": "number"
        },
        "multi_medium_release_complexity": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Multi Medium Release Complexity",
          "type": "number"
        },
        "unsupported_runtime_parameters": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unsupported Runtime Parameters",
          "type": "number"
        },
        "missing_required_inputs": {
          "default": 0.35,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Required Inputs",
          "type": "number"
        },
        "missing_substance_class": {
          "default": 0.3,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Substance Class",
          "type": "number"
        },
        "unsupported_substance_class": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unsupported Substance Class",
          "type": "number"
        }
      },
      "title": "FitAssessmentPenaltyWeights",
      "type": "object"
    },
    "FitForPurpose": {
      "enum": [
        "screening",
        "downstream_export",
        "benchmark"
      ],
      "title": "FitForPurpose",
      "type": "string"
    },
    "LimitationNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "LimitationNote",
      "type": "object"
    },
    "Media": {
      "enum": [
        "air",
        "water",
        "soil",
        "sediment"
      ],
      "title": "Media",
      "type": "string"
    },
    "ModelFamily": {
      "enum": [
        "reference_mass_balance",
        "advective_screening_mass_balance",
        "fugacity_equilibrium_screening",
        "adapter_stub",
        "external_result_adapter"
