        "evidence_quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Quality"
        },
        "runtime_consumed": {
          "title": "Runtime Consumed",
          "type": "boolean"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Reference Ids",
          "type": "array"
        },
        "quality_flag_codes": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flag Codes",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
