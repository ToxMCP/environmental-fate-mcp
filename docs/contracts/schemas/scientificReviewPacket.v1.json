          "items": {
            "type": "string"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "core_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Core Assumptions",
          "type": "array"
        },
        "deferred_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Deferred Capabilities",
          "type": "array"
        },
        "review_notes": {
          "items": {
            "type": "string"
          },
          "title": "Review Notes",
          "type": "array"
        },
        "fit_score_threshold": {
          "default": 0.75,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fit Score Threshold",
          "type": "number"
        },
        "fit_score_penalties": {
          "$ref": "#/$defs/FitAssessmentPenaltyWeights"
        },
        "source_pack": {
          "title": "Source Pack",
          "type": "string"
        },
        "applicability_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
