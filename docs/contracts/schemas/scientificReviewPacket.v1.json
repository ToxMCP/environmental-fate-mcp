          "default": null,
          "title": "Applicability Note"
        }
      },
      "required": [
        "model_family",
        "source_pack"
      ],
      "title": "ModelFamilyApplicabilityProfile",
      "type": "object"
    },
    "ProvenanceBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "defaults_version": {
          "default": "v1",
          "title": "Defaults Version",
          "type": "string"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "source_references": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "algorithm_version",
        "generated_at"
      ],
      "title": "ProvenanceBundle",
      "type": "object"
    },
    "ReleaseScenarioFitAssessment": {
      "additionalProperties": false,
      "properties": {
        "fit_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fit Score",
          "type": "number"
        },
        "model_family": {
          "$ref": "#/$defs/ModelFamily"
        },
        "fit_for_purpose": {
          "$ref": "#/$defs/FitForPurpose"
        },
        "verdict": {
          "title": "Verdict",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "applicability_profile": {
          "$ref": "#/$defs/ModelFamilyApplicabilityProfile"
        },
        "applicability_lines": {
          "items": {
            "type": "string"
          },
          "title": "Applicability Lines",
          "type": "array"
        },
        "scientific_unsuitability_lines": {
          "items": {
            "type": "string"
          },
          "title": "Scientific Unsuitability Lines",
          "type": "array"
        }
      },
      "required": [
        "fit_score",
        "model_family",
        "fit_for_purpose",
        "verdict",
        "reasons",
        "applicability_profile"
      ],
      "title": "ReleaseScenarioFitAssessment",
      "type": "object"
    },
    "RunDefaultProofPosture": {
      "enum": [
        "rebaselined_shipped_defaults",
        "rebaselined_defaults_with_governed_overrides",
        "scenario_specific_non_default_values",
        "legacy_continuity_extension"
      ],
      "title": "RunDefaultProofPosture",
      "type": "string"
    },
    "RunMode": {
      "enum": [
        "steady_state",
        "time_bucket"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "RunParameterManifest": {
      "additionalProperties": false,
