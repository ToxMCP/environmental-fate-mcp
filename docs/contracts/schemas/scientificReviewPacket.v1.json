          "title": "Core Default Assumption Count",
          "type": "integer"
        },
        "summary_lines": {
          "items": {
            "type": "string"
          },
          "title": "Summary Lines",
          "type": "array"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/LimitationNote"
