{
  "$defs": {
    "FitForPurpose": {
      "enum": [
        "screening",
        "downstream_export",
        "benchmark"
      ],
      "title": "FitForPurpose",
      "type": "string"
    },
    "ModelFamily": {
      "enum": [
        "reference_mass_balance",
        "advective_screening_mass_balance",
        "adapter_stub",
        "external_result_adapter"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "ModelFamilyComparisonOutcome": {
      "enum": [
        "comparable_screening_outputs",
        "material_model_family_divergence",
        "review_needed"
      ],
      "title": "ModelFamilyComparisonOutcome",
      "type": "string"
    },
    "ModelFamilyComparisonReviewChecklistTemplate": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_hint_fields": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Hint Fields",
          "type": "array"
        }
      },
      "required": [
        "code",
        "prompt",
        "rationale"
      ],
      "title": "ModelFamilyComparisonReviewChecklistTemplate",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "steady_state",
        "time_bucket"
      ],
      "title": "RunMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "base_model_family": {
      "$ref": "#/$defs/ModelFamily"
    },
    "candidate_model_family": {
      "$ref": "#/$defs/ModelFamily"
    },
    "fit_for_purpose": {
      "items": {
        "$ref": "#/$defs/FitForPurpose"
      },
      "title": "Fit For Purpose",
      "type": "array"
    },
    "supported_run_modes": {
      "items": {
        "$ref": "#/$defs/RunMode"
      },
      "title": "Supported Run Modes",
      "type": "array"
    },
    "material_relative_delta_threshold": {
      "minimum": 0.0,
      "title": "Material Relative Delta Threshold",
      "type": "number"
    },
    "material_absolute_delta_floor": {
      "minimum": 0.0,
      "title": "Material Absolute Delta Floor",
      "type": "number"
    },
    "packet_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Packet Template"
    },
    "brief_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brief Template"
    },
    "comparable_outcome_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparable Outcome Template"
    },
    "divergence_outcome_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Divergence Outcome Template"
    },
    "review_needed_outcome_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Needed Outcome Template"
    },
    "review_checklist": {
      "items": {
        "$ref": "#/$defs/ModelFamilyComparisonReviewChecklistTemplate"
      },
      "title": "Review Checklist",
      "type": "array"
    },
    "review_packet_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Packet Template"
    },
    "review_brief_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Brief Template"
    },
    "ready_comparison_outcomes": {
      "items": {
        "$ref": "#/$defs/ModelFamilyComparisonOutcome"
      },
      "title": "Ready Comparison Outcomes",
      "type": "array"
    },
    "attention_outcomes": {
      "items": {
        "$ref": "#/$defs/ModelFamilyComparisonOutcome"
      },
      "title": "Attention Outcomes",
      "type": "array"
    },
    "attention_if_any_checks_fail": {
      "default": true,
      "title": "Attention If Any Checks Fail",
      "type": "boolean"
    },
    "attention_if_candidate_experimental": {
      "default": true,
      "title": "Attention If Candidate Experimental",
      "type": "boolean"
    },
    "review_notes": {
      "items": {
        "type": "string"
      },
      "title": "Review Notes",
      "type": "array"
    },
    "source_pack": {
      "title": "Source Pack",
      "type": "string"
    },
    "applicability_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability Note"
    }
  },
  "required": [
    "profile_id",
    "display_name",
    "base_model_family",
    "candidate_model_family",
    "material_relative_delta_threshold",
    "material_absolute_delta_floor",
    "source_pack"
  ],
  "title": "ModelFamilyComparisonProfile",
  "type": "object"
}
