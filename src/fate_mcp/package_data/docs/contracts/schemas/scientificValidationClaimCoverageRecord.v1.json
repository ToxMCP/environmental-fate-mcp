      "type": "string"
    },
    "ScientificValidationClaimPriority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ScientificValidationClaimPriority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "model_family": {
