    },
    "supporting_fixture_count": {
      "default": 0,
      "title": "Supporting Fixture Count",
      "type": "integer"
    },
    "supporting_validation_tier_count": {
      "default": 0,
      "title": "Supporting Validation Tier Count",
      "type": "integer"
    },
    "supporting_fixture_names": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Fixture Names",
      "type": "array"
    },
    "supporting_categories": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Categories",
      "type": "array"
    },
    "supporting_reference_types": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Reference Types",
      "type": "array"
    },
    "supporting_validation_tiers": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Validation Tiers",
      "type": "array"
    },
    "satisfies_required_reference_types": {
      "default": true,
      "title": "Satisfies Required Reference Types",
      "type": "boolean"
    },
    "satisfies_required_validation_tiers": {
      "default": true,
      "title": "Satisfies Required Validation Tiers",
      "type": "boolean"
    },
    "gap_lines": {
      "items": {
        "type": "string"
      },
      "title": "Gap Lines",
      "type": "array"
    }
